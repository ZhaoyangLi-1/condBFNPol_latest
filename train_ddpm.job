#!/bin/bash
#SBATCH --account=ACCOUNT_NAME
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-task=a100:1
#SBATCH --mem=80G
#SBATCH --time=4:00:00
#SBATCH --job-name=ddpm_pusht
#SBATCH --output=$PROJECT_ROOT/jobs/logs/%x_%j.out
#SBATCH --error=$PROJECT_ROOT/jobs/logs/%x_%j.err

# Train DDPM (Denoising Diffusion Probabilistic Models) baseline on PushT
# DDPM uses stochastic sampling with all 100 denoising steps

# Adjust batch size based on GPU
BATCH_SIZE=128  # For A100/A40. Use 32 for V100

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn

cd $PROJECT_ROOT

# Use our train_workspace.py with the benchmark_diffusion_pusht config
$HOME/.conda/envs/bfn/bin/python scripts/train_workspace.py \
    --config-name=benchmark_diffusion_pusht \
    dataloader.batch_size=${BATCH_SIZE} \
    val_dataloader.batch_size=${BATCH_SIZE}
