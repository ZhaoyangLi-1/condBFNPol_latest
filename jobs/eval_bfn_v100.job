#!/bin/bash
#SBATCH --account=biyik_1173
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-task=v100:1
#SBATCH --mem=32G
#SBATCH --time=2:00:00
#SBATCH --job-name=eval_bfn_v100
#SBATCH --output=jobs/logs/%x_%j.out
#SBATCH --error=jobs/logs/%x_%j.err

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn
cd "$SLURM_SUBMIT_DIR"

python scripts/eval_lunar_lander.py \
    --checkpoint outputs/2026.04.09/10.20.28_train_bfn_hybrid_lunar_lander_lunar_lander/checkpoints/latest.ckpt \
    --policy_type bfn \
    --num_episodes 50 \
    --record_video \
    --video_every 10 \
    --video_dir outputs/eval_videos/bfn_new_fixed \
    --output outputs/eval_results/bfn_new_fixed.json
