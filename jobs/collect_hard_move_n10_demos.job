#!/bin/bash
#SBATCH --account=ACCOUNT_NAME
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gpus-per-task=v100:1
#SBATCH --mem=16G
#SBATCH --time=8:00:00
#SBATCH --job-name=collect_n10
#SBATCH --output=jobs/logs/%x_%j.out
#SBATCH --error=jobs/logs/%x_%j.err

# Collect Hard Move n=10 demos using DLPA best checkpoint
# Allowing 8h since n=10 has 1024 actions - MPPI is slow

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn

cd "$SLURM_SUBMIT_DIR"

CHECKPOINT="_external/DLPA/result/DLPA/simple_move_4_direction_v1/hard_move_n10_seed0/world_model_best_0.pth"

echo "Collecting Hard Move n=10 demos using best checkpoint"
python scripts/collect_hard_move_demos.py \
    --n_actuators 10 \
    --checkpoint "$CHECKPOINT" \
    --n_episodes 200 \
    --output "data/hard_move_n10/replay.zarr"

echo "Done at $(date)"
