#!/bin/bash
#SBATCH --account=biyik_1173
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-task=p100:1
#SBATCH --mem=32G
#SBATCH --time=12:00:00
#SBATCH --job-name=train_cp
#SBATCH --output=jobs/logs/%x_%j.out
#SBATCH --error=jobs/logs/%x_%j.err
#SBATCH --array=0-2

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn

cd "$SLURM_SUBMIT_DIR"

case $SLURM_ARRAY_TASK_ID in
    0) CONFIG="train_bfn_catch_point"; MODEL="BFN" ;;
    1) CONFIG="train_ddpm_catch_point"; MODEL="DDPM" ;;
    2) CONFIG="train_edm_catch_point"; MODEL="EDM" ;;
esac

echo "Training $MODEL on Catch Point"
python train.py --config-name=$CONFIG
echo "Done at $(date)"
