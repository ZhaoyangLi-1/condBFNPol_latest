#!/bin/bash
#SBATCH --account=ACCOUNT_NAME
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-task=p100:1
#SBATCH --mem=32G
#SBATCH --time=8:00:00
#SBATCH --job-name=con_distill
#SBATCH --output=jobs/logs/%x_%j.out
#SBATCH --error=jobs/logs/%x_%j.err

# Train Consistency models with EDM teacher distillation

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn

cd "$SLURM_SUBMIT_DIR"

echo "=========================================="
echo "SLURM_JOB_ID = $SLURM_JOB_ID"
echo "SLURM_JOB_NODELIST = $SLURM_JOB_NODELIST"
echo "TMPDIR = $TMPDIR"
echo "=========================================="

echo "Training Consistency 1-step with EDM teacher at $(date)"
python train.py --config-name=train_consistency_lunar_lander_1step

echo ""
echo "=========================================="

echo "Training Consistency 3-step with EDM teacher at $(date)"
python train.py --config-name=train_consistency_lunar_lander_3step

echo ""
echo "=========================================="
echo "All training completed at $(date)"
