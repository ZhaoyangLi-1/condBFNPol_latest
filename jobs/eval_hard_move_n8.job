#!/bin/bash
#SBATCH --account=biyik_1173
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gpus-per-task=p100:1
#SBATCH --mem=16G
#SBATCH --time=2:00:00
#SBATCH --job-name=eval_hm_n8
#SBATCH --output=jobs/logs/%x_%j.out
#SBATCH --error=jobs/logs/%x_%j.err

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn

cd "$SLURM_SUBMIT_DIR"

BFN_CKPT="outputs/2026.04.29/18.03.54_train_bfn_hard_move_n8_hard_move_n8/checkpoints/latest.ckpt"
DDPM_CKPT="outputs/2026.04.29/18.04.27_train_ddpm_hard_move_n8_hard_move_n8/checkpoints/latest.ckpt"

echo "Evaluating Hard Move n=8 (256 actions)"
python scripts/eval_hard_move.py \
    --n_actuators 8 \
    --bfn_ckpt "$BFN_CKPT" \
    --bfn10_ckpt "$BFN_CKPT" \
    --ddpm_ckpt "$DDPM_CKPT" \
    --ddim_ckpt "$DDPM_CKPT" \
    --n_episodes 50

echo "Done at $(date)"
