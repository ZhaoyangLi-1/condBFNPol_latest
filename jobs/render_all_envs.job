#!/bin/bash
#SBATCH --account=biyik_1165
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=24G
#SBATCH --time=0:45:00
#SBATCH --job-name=rend_all
#SBATCH --output=jobs/logs/%x_%a_%j.out
#SBATCH --error=jobs/logs/%x_%a_%j.err
#SBATCH --array=0-7

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn
cd "$SLURM_SUBMIT_DIR"
export SDL_VIDEODRIVER=dummy
export BFN_NATIVE_RENDER=1
mkdir -p videos

ARCH=/scratch1/abhajha/condBFNPol_archive
# (env, seed, n_actuators, bfn_ckpt, ddpm_ckpt, cons_ckpt)
case "$SLURM_ARRAY_TASK_ID" in
  0)
    ENV=platform; SEED=7; NA=0
    BFN=outputs/2026.05.23/19.49.00_train_bfn_platform_132_platform_132/checkpoints/latest.ckpt
    DDPM=outputs/2026.05.23/19.49.00_train_ddpm_platform_132_platform_132/checkpoints/latest.ckpt
    CONS=outputs/2026.05.23/20.14.31_train_consistency_platform_132_platform_132/checkpoints/latest.ckpt ;;
  1)
    ENV=goal; SEED=0; NA=0
    BFN=outputs/2026.05.04/23.00.11_train_bfn_goal_goal/checkpoints/latest.ckpt
    DDPM=outputs/2026.05.23/19.49.00_train_ddpm_goal_132_goal_132/checkpoints/latest.ckpt
    CONS=outputs/2026.05.05/00.09.31_train_consistency_goal_goal/checkpoints/latest.ckpt ;;
  2)
    ENV=hard_goal; SEED=5; NA=0
    BFN=outputs/2026.05.01/22.13.48_train_bfn_hard_goal_hard_goal/checkpoints/latest.ckpt
    DDPM=outputs/2026.05.01/22.13.48_train_ddpm_hard_goal_hard_goal/checkpoints/latest.ckpt
    CONS=outputs/2026.05.01/23.23.00_train_consistency_hard_goal_hard_goal/checkpoints/latest.ckpt ;;
  3)
    ENV=catch_point; SEED=7; NA=0
    BFN=outputs/2026.05.03/21.20.02_train_bfn_catch_point_catch_point/checkpoints/latest.ckpt
    DDPM=outputs/2026.05.03/21.20.04_train_ddpm_catch_point_catch_point/checkpoints/latest.ckpt
    CONS=outputs/2026.05.04/09.54.08_train_consistency_catch_point_catch_point/checkpoints/latest.ckpt ;;
  4)
    ENV=hard_move_n4; SEED=73; NA=4
    BFN=$ARCH/2026.04.29/14.03.32_train_bfn_hard_move_n4_hard_move_n4/checkpoints/latest.ckpt
    DDPM=$ARCH/2026.04.29/14.03.32_train_ddpm_hard_move_n4_hard_move_n4/checkpoints/latest.ckpt
    CONS=$ARCH/2026.04.29/15.34.22_train_consistency_hard_move_n4_hard_move_n4/checkpoints/latest.ckpt ;;
  5)
    ENV=hard_move_n6; SEED=7; NA=6
    BFN=$ARCH/2026.04.29/14.56.56_train_bfn_hard_move_n6_hard_move_n6/checkpoints/latest.ckpt
    DDPM=$ARCH/2026.04.29/14.56.57_train_ddpm_hard_move_n6_hard_move_n6/checkpoints/latest.ckpt
    CONS=outputs/2026.04.30/01.51.15_train_consistency_hard_move_n6_hard_move_n6/checkpoints/latest.ckpt ;;
  6)
    ENV=hard_move_n8; SEED=7; NA=8
    BFN=$ARCH/2026.04.29/18.03.54_train_bfn_hard_move_n8_hard_move_n8/checkpoints/latest.ckpt
    DDPM=$ARCH/2026.04.29/18.04.27_train_ddpm_hard_move_n8_hard_move_n8/checkpoints/latest.ckpt
    CONS=outputs/2026.04.30/02.49.00_train_consistency_hard_move_n8_hard_move_n8/checkpoints/latest.ckpt ;;
  7)
    ENV=hard_move_n10; SEED=7; NA=10
    BFN=outputs/2026.05.23/19.49.00_train_bfn_hard_move_n10_132_hard_move_n10_132/checkpoints/latest.ckpt
    DDPM=outputs/2026.05.23/19.49.00_train_ddpm_hard_move_n10_132_hard_move_n10_132/checkpoints/latest.ckpt
    CONS=outputs/2026.05.23/20.14.31_train_consistency_hard_move_n10_132_hard_move_n10_132/checkpoints/latest.ckpt ;;
esac

ARGS="--env $ENV --bfn_ckpt $BFN --ddpm_ckpt $DDPM --consistency_ckpt $CONS --seed $SEED --out videos/${ENV}.mp4 --fps 6"
if [ "$NA" != "0" ]; then ARGS="$ARGS --n_actuators $NA"; fi
python scripts/render_rollouts.py $ARGS
echo "Done $ENV seed=$SEED"
