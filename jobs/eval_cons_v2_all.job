#!/bin/bash
#SBATCH --account=biyik_1173
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gpus-per-task=p100:1
#SBATCH --mem=16G
#SBATCH --time=1:30:00
#SBATCH --job-name=eval_cons_v2
#SBATCH --output=jobs/logs/%x_%j.out
#SBATCH --error=jobs/logs/%x_%j.err
#SBATCH --array=0-3

# Re-evaluate Consistency v2 (with EMA 0.999) on all hard move + catch point
# Hard Goal already done separately

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn

cd "$SLURM_SUBMIT_DIR"

case $SLURM_ARRAY_TASK_ID in
    0) N=4; CKPT="outputs/2026.05.04/09.54.06_train_consistency_hard_move_n4_hard_move_n4/checkpoints/latest.ckpt"; SCRIPT="eval_hard_move.py"; ARGS="--n_actuators 4" ;;
    1) N=6; CKPT="outputs/2026.05.04/09.54.08_train_consistency_hard_move_n6_hard_move_n6/checkpoints/latest.ckpt"; SCRIPT="eval_hard_move.py"; ARGS="--n_actuators 6" ;;
    2) N=8; CKPT="outputs/2026.05.04/09.54.06_train_consistency_hard_move_n8_hard_move_n8/checkpoints/latest.ckpt"; SCRIPT="eval_hard_move.py"; ARGS="--n_actuators 8" ;;
    3) N="cp"; CKPT="outputs/2026.05.04/09.54.08_train_consistency_catch_point_catch_point/checkpoints/latest.ckpt"; SCRIPT="eval_catch_point.py"; ARGS="" ;;
esac

echo "Evaluating Consistency v2 ${N} (1+3 step)"
python scripts/$SCRIPT \
    $ARGS \
    --consistency_ckpt "$CKPT" \
    --consistency3_ckpt "$CKPT" \
    --n_episodes 50

echo "Done at $(date)"
