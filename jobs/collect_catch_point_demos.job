#!/bin/bash
#SBATCH --account=ACCOUNT_NAME
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gpus-per-task=v100:1
#SBATCH --mem=16G
#SBATCH --time=4:00:00
#SBATCH --job-name=collect_cp
#SBATCH --output=jobs/logs/%x_%j.out
#SBATCH --error=jobs/logs/%x_%j.err

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn

cd "$SLURM_SUBMIT_DIR"

CHECKPOINT="_external/DLPA/result/DLPA/simple_catch/catch_point_seed0/world_model_best_0.pth"

echo "Collecting Catch Point demos using best checkpoint (+12.07)"
python scripts/collect_catch_point_demos.py \
    --checkpoint "$CHECKPOINT" \
    --n_episodes 500 \
    --output "data/catch_point/replay.zarr"

echo "Done at $(date)"
