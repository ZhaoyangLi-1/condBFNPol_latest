#!/bin/bash
#SBATCH --account=ACCOUNT_NAME
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=24G
#SBATCH --time=0:45:00
#SBATCH --job-name=rend_hm
#SBATCH --output=jobs/logs/%x_%a_%j.out
#SBATCH --error=jobs/logs/%x_%a_%j.err
#SBATCH --array=6,8,10

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn
cd "$SLURM_SUBMIT_DIR"
mkdir -p videos

ARCH=$ARCHIVE_DIR
N=$SLURM_ARRAY_TASK_ID

case "$N" in
  6)
    BFN=$ARCH/2026.04.29/14.56.56_train_bfn_hard_move_n6_hard_move_n6/checkpoints/latest.ckpt
    DDPM=$ARCH/2026.04.29/14.56.57_train_ddpm_hard_move_n6_hard_move_n6/checkpoints/latest.ckpt
    CONS=outputs/2026.04.30/01.51.15_train_consistency_hard_move_n6_hard_move_n6/checkpoints/latest.ckpt
    ;;
  8)
    BFN=$ARCH/2026.04.29/18.03.54_train_bfn_hard_move_n8_hard_move_n8/checkpoints/latest.ckpt
    DDPM=$ARCH/2026.04.29/18.04.27_train_ddpm_hard_move_n8_hard_move_n8/checkpoints/latest.ckpt
    CONS=outputs/2026.04.30/02.49.00_train_consistency_hard_move_n8_hard_move_n8/checkpoints/latest.ckpt
    ;;
  10)
    BFN=outputs/2026.05.23/19.49.00_train_bfn_hard_move_n10_132_hard_move_n10_132/checkpoints/latest.ckpt
    DDPM=outputs/2026.05.23/19.49.00_train_ddpm_hard_move_n10_132_hard_move_n10_132/checkpoints/latest.ckpt
    CONS=outputs/2026.05.23/20.14.31_train_consistency_hard_move_n10_132_hard_move_n10_132/checkpoints/latest.ckpt
    ;;
esac

python scripts/render_rollouts.py \
  --env hard_move_n${N} --n_actuators $N \
  --bfn_ckpt "$BFN" --ddpm_ckpt "$DDPM" --consistency_ckpt "$CONS" \
  --seed 7 --out videos/hard_move_n${N}.mp4 --fps 6

echo "Done n=$N at $(date)"