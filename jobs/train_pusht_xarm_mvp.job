#!/bin/bash
#SBATCH --account=biyik_1173
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-task=v100:1
#SBATCH --mem=32G
#SBATCH --time=12:00:00
#SBATCH --job-name=pusht_xarm_mvp
#SBATCH --output=jobs/logs/%x_%a_%j.out
#SBATCH --error=jobs/logs/%x_%a_%j.err
#SBATCH --array=0-1

# 0: BFN hybrid image, top camera
# 1: DDPM image, 9D one-hot action, top camera

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn

cd "$SLURM_SUBMIT_DIR"

case $SLURM_ARRAY_TASK_ID in
    0) CONFIG="train_bfn_pusht_xarm_top"; MODEL="BFN-Hybrid" ;;
    1) CONFIG="train_ddpm_pusht_xarm_top"; MODEL="DDPM-OneHot" ;;
esac

echo "Training $MODEL on PushT-xarm (merged, top camera)"
python train.py --config-name=$CONFIG
echo "Done at $(date)"
