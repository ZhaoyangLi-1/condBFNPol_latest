#!/bin/bash
#SBATCH --account=biyik_1173
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-task=a40:1
#SBATCH --mem=32G
#SBATCH --time=24:00:00
#SBATCH --job-name=sac_ext
#SBATCH --output=jobs/logs/%x_%j.out
#SBATCH --error=jobs/logs/%x_%j.err

# Train Hybrid SAC on Extended Lunar Lander (16 discrete actions)

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn

cd "$SLURM_SUBMIT_DIR"

echo "Training Hybrid SAC on Extended Lunar Lander (16 actions)"
echo "=========================================="
echo "Start time: $(date)"

python scripts/train_hybrid_sac_extended.py

echo "=========================================="
echo "End time: $(date)"
