#!/bin/bash
#SBATCH --account=ACCOUNT_NAME
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-task=p100:1
#SBATCH --mem=32G
#SBATCH --time=24:00:00
#SBATCH --job-name=bfn_extended
#SBATCH --output=jobs/logs/%x_%j.out
#SBATCH --error=jobs/logs/%x_%j.err

# Train BFN on Extended Lunar Lander (16 actions)

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn

cd "$SLURM_SUBMIT_DIR"

echo "=========================================="
echo "SLURM_JOB_ID = $SLURM_JOB_ID"
echo "SLURM_JOB_NODELIST = $SLURM_JOB_NODELIST"
echo "=========================================="

echo "Training BFN on 16-action Lunar Lander at $(date)"
python train.py --config-name=train_bfn_lunar_lander_extended

echo "Done at $(date)"
