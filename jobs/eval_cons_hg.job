#!/bin/bash
#SBATCH --account=ACCOUNT_NAME
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gpus-per-task=p100:1
#SBATCH --mem=16G
#SBATCH --time=1:00:00
#SBATCH --job-name=eval_cons_hg
#SBATCH --output=jobs/logs/%x_%j.out
#SBATCH --error=jobs/logs/%x_%j.err

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn

cd "$SLURM_SUBMIT_DIR"

CONS_CKPT="outputs/2026.05.01/23.23.00_train_consistency_hard_goal_hard_goal/checkpoints/latest.ckpt"

echo "Evaluating Consistency Policy on Hard Goal (1+3 step)"
python scripts/eval_hard_goal.py \
    --consistency_ckpt "$CONS_CKPT" \
    --consistency3_ckpt "$CONS_CKPT" \
    --n_episodes 50

echo "Done at $(date)"
