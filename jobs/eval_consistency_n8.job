#!/bin/bash
#SBATCH --account=biyik_1173
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gpus-per-task=p100:1
#SBATCH --mem=16G
#SBATCH --time=1:00:00
#SBATCH --job-name=eval_cons_n8
#SBATCH --output=jobs/logs/%x_%j.out
#SBATCH --error=jobs/logs/%x_%j.err

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn

cd "$SLURM_SUBMIT_DIR"

CONS_CKPT="outputs/2026.04.30/02.49.00_train_consistency_hard_move_n8_hard_move_n8/checkpoints/latest.ckpt"

echo "Evaluating Consistency Policy on Hard Move n=8 (256 actions, 1-step + 3-step)"
python scripts/eval_hard_move.py \
    --n_actuators 8 \
    --consistency_ckpt "$CONS_CKPT" \
    --consistency3_ckpt "$CONS_CKPT" \
    --n_episodes 50

echo "Done at $(date)"
