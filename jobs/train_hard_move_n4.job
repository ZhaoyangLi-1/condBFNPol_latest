#!/bin/bash
#SBATCH --account=ACCOUNT_NAME
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-task=p100:1
#SBATCH --mem=32G
#SBATCH --time=24:00:00
#SBATCH --job-name=train_hm_n4
#SBATCH --output=jobs/logs/%x_%j.out
#SBATCH --error=jobs/logs/%x_%j.err
#SBATCH --array=0-2

# Train BFN, DDPM, and EDM (teacher for Consistency) on Hard Move n=4 in parallel
# Array index: 0->BFN, 1->DDPM, 2->EDM

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn

cd "$SLURM_SUBMIT_DIR"

case $SLURM_ARRAY_TASK_ID in
    0) CONFIG="train_bfn_hard_move_n4"; MODEL="BFN" ;;
    1) CONFIG="train_ddpm_hard_move_n4"; MODEL="DDPM" ;;
    2) CONFIG="train_edm_hard_move_n4"; MODEL="EDM" ;;
esac

echo "=========================================="
echo "SLURM_JOB_ID = $SLURM_JOB_ID"
echo "SLURM_ARRAY_TASK_ID = $SLURM_ARRAY_TASK_ID"
echo "Training $MODEL on Hard Move n=4 (16 actions)"
echo "Config: $CONFIG"
echo "=========================================="

python train.py --config-name=$CONFIG

echo "Done at $(date)"
