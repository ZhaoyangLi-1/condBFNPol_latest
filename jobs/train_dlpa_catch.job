#!/bin/bash
#SBATCH --account=biyik_1173
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gpus-per-task=v100:1
#SBATCH --mem=32G
#SBATCH --time=24:00:00
#SBATCH --job-name=dlpa_catch
#SBATCH --output=jobs/logs/%x_%j.out
#SBATCH --error=jobs/logs/%x_%j.err

# Train DLPA expert on Catch Point (simple_catch-v0)
# 2 discrete actions: 0=move (with angle param), 1=catch (no param)

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn

cd $PROJECT_ROOT/_external/DLPA

SAVE_DIR="catch_point_seed0"

echo "=========================================="
echo "Training DLPA on Catch Point"
echo "Save dir: $SAVE_DIR"
echo "=========================================="

# DLPA paper used different mpc_horizon for catch
python main.py \
    --env 'simple_catch-v0' \
    --mpc_horizon 5 \
    --model_type "concat" \
    --save_points 0 \
    --max_timesteps 200000 \
    --eval_freq 5000 \
    --seed 0 \
    --save_dir $SAVE_DIR

echo "Done at $(date)"
