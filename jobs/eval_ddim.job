#!/bin/bash
#SBATCH --account=biyik_1173
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-task=v100:1
#SBATCH --mem=32G
#SBATCH --time=1:00:00
#SBATCH --job-name=eval_ddim
#SBATCH --output=jobs/logs/%x_%j.out
#SBATCH --error=jobs/logs/%x_%j.err

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn
cd "$SLURM_SUBMIT_DIR"

# DDIM uses DDPM checkpoint with swapped scheduler (20 steps instead of 100)
python scripts/eval_lunar_lander.py \
    --checkpoint outputs/2026.04.08/13.54.49_train_ddpm_lunar_lander_lunar_lander/checkpoints/latest.ckpt \
    --policy_type ddim \
    --num_episodes 50 \
    --record_video \
    --video_every 10 \
    --video_dir outputs/eval_videos/ddim \
    --output outputs/eval_results/ddim.json
