#!/bin/bash
#SBATCH --account=biyik_1173
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-task=a100:1
#SBATCH --mem=40G
#SBATCH --time=4:00:00
#SBATCH --job-name=benchmark_partial
#SBATCH --output=jobs/logs/%x_%j.out
#SBATCH --error=jobs/logs/%x_%j.err

# Benchmark completed policies (BFN, EDM, Consistency) on PushT
# DDPM and DDIM will be added once training completes

# Best checkpoint paths
BFN_CKPT="$PROJECT_ROOT/outputs/2026.01.26/19.06.04_bfn_seed42/checkpoints/epoch=0200-test_mean_score=0.907.ckpt"
EDM_CKPT="$PROJECT_ROOT/outputs/2026.02.28/00.53.41_edm_teacher_seed42/checkpoints/epoch=0150-test_mean_score=0.921.ckpt"
CONSISTENCY_CKPT="$PROJECT_ROOT/outputs/2026.02.28/03.03.17_consistency_seed42/checkpoints/epoch=0075-test_mean_score=0.871.ckpt"

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn

cd "$SLURM_SUBMIT_DIR"

# Run benchmark (using -u for unbuffered output)
$HOME/.conda/envs/bfn/bin/python -u scripts/benchmark_policies.py \
    --bfn_ckpt "${BFN_CKPT}" \
    --edm_ckpt "${EDM_CKPT}" \
    --consistency_ckpt "${CONSISTENCY_CKPT}" \
    --output results/pusht_benchmark_partial_$(date +%Y%m%d_%H%M%S).json \
    --device cuda
