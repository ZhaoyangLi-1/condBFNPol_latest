#!/bin/bash
#SBATCH --account=biyik_1165
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:p100:1
#SBATCH --mem=24G
#SBATCH --time=0:30:00
#SBATCH --job-name=time_inf
#SBATCH --output=jobs/logs/%x_%j.out
#SBATCH --error=jobs/logs/%x_%j.err

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn
cd "$SLURM_SUBMIT_DIR"

python scripts/time_inference_pamdp.py --out results/inference_timing_pamdp.json
echo "Done at $(date)"
