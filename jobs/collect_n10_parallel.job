#!/bin/bash
#SBATCH --account=ACCOUNT_NAME
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gpus-per-task=v100:1
#SBATCH --mem=16G
#SBATCH --time=24:00:00
#SBATCH --job-name=collect_n10_p
#SBATCH --output=jobs/logs/%x_%a_%j.out
#SBATCH --error=jobs/logs/%x_%a_%j.err
#SBATCH --array=0-3

# 4 parallel collections, 200 episodes each, different seeds
# Expected: 4 x 200 x 17% = ~136 successful episodes

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn

cd "$SLURM_SUBMIT_DIR"

CKPT="_external/DLPA/result/DLPA/simple_move_4_direction_v1/hard_move_n10_seed0_48h/world_model_best_0.pth"
SEED=$((100 + SLURM_ARRAY_TASK_ID))
OUT="data/hard_move_n10/replay_seed${SEED}.zarr"

echo "Collecting n=10 (seed=$SEED, 200 episodes) -> $OUT"
python scripts/collect_hard_move_demos.py \
    --n_actuators 10 \
    --checkpoint "$CKPT" \
    --n_episodes 200 \
    --seed $SEED \
    --output "$OUT"

echo "Done at $(date)"
