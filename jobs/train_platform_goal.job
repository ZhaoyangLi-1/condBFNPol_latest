#!/bin/bash
#SBATCH --account=ACCOUNT_NAME
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus-per-task=p100:1
#SBATCH --mem=32G
#SBATCH --time=12:00:00
#SBATCH --job-name=train_pg
#SBATCH --output=jobs/logs/%x_%j.out
#SBATCH --error=jobs/logs/%x_%j.err
#SBATCH --array=0-5

# Train BFN, DDPM, EDM on Platform (0-2) and Goal (3-5)

source /apps/conda/miniforge3/24.11.3/etc/profile.d/conda.sh
conda activate bfn

cd "$SLURM_SUBMIT_DIR"

case $SLURM_ARRAY_TASK_ID in
    0) CONFIG="train_bfn_platform"; LABEL="Platform-BFN" ;;
    1) CONFIG="train_ddpm_platform"; LABEL="Platform-DDPM" ;;
    2) CONFIG="train_edm_platform"; LABEL="Platform-EDM" ;;
    3) CONFIG="train_bfn_goal"; LABEL="Goal-BFN" ;;
    4) CONFIG="train_ddpm_goal"; LABEL="Goal-DDPM" ;;
    5) CONFIG="train_edm_goal"; LABEL="Goal-EDM" ;;
esac

echo "Training $LABEL"
python train.py --config-name=$CONFIG
echo "Done at $(date)"
